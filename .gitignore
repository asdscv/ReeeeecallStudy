# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.dev.vars

# Supabase local
supabase/.branches/
supabase/.temp/

# Test artifacts
api test

# Compiled artifacts that leak into source dirs (TypeScript build output)
# These must NEVER be committed — Metro/Vite resolve from source.
packages/shared/**/*.js
packages/shared/**/*.js.map
packages/shared/**/*.d.ts
packages/shared/**/*.d.ts.map
!packages/shared/index.ts
packages/mobile/shared/
packages/mobile/mobile/

# Playwright
playwright-report/
# `**/` is load-bearing. A pattern containing a non-trailing slash is anchored to the
# directory holding the .gitignore, so the old `playwright/.auth/` only ever matched
# <repo-root>/playwright/.auth/ — never packages/web/playwright/.auth/, which is where
# Playwright actually writes. A saved storage state containing a live Supabase session
# for a real account was tracked here for months because of that one missing prefix.
**/playwright/.auth/
test-results/
blob-report/
.env.test

# Apple private keys
AuthKey_*.p8

# Service-account keys for the Supabase edge functions (secret — never commit).
# The runtime reads these from Supabase Edge Function SECRETS, not from disk; the
# local copy exists only so the secret can be re-registered without re-issuing a key.
supabase/.secrets/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# CSV import sidecars (transient process state)
STUDY_DATA/*.checkpoint
STUDY_DATA/*.tmp

# Stray Expo prebuild output at repo root (real native projects live in
# packages/mobile/{android,ios}, already ignored there). Prevents accidental
# commit of ~2GB of regenerable build artifacts.
/android/
/ios/

# Claude Code personal settings (never commit)
.claude/settings.local.json

# TypeScript incremental build state. Regenerated by `tsc -b`; machine-specific
# absolute paths inside, so committing it produces noisy conflicts.
*.tsbuildinfo

# Scratch images at the repo ROOT only (screenshots, phone photos, design refs).
# `/`-anchored on purpose — packages/** and DOCS/** legitimately hold images.
# ~6.5MB of KakaoTalk/iPad screenshots had been sitting untracked at the root,
# and `git add -A` would have committed every one of them.
/*.jpeg
/*.jpg
/*.png
/*.webp
/pronounciation_chinese/

# Download-collision filenames: "<name>.csv <timestamp>.csv" / "<name>.jpeg <ts>.jpeg".
# STUDY_DATA/ is a TRACKED content directory (53 deck CSVs), so a stray
# "english_260226.csv 10-08-21-813.csv" would slip into real deck content on
# `git add STUDY_DATA`. Real deck files never contain a space.
STUDY_DATA/* *
