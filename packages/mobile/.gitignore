# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# E2E credentials — never committed (the helpers read them from here)
.env.test

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Google Play service-account key (secret — never commit)
google-service-account.json
google-service-account*.json

