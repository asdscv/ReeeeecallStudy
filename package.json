{
  "name": "reeeeecall",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @reeeeecall/web dev",
    "build": "pnpm --filter @reeeeecall/web build",
    "test": "pnpm --filter @reeeeecall/web test",
    "lint": "pnpm --filter @reeeeecall/web lint",
    "dev:mobile": "pnpm --filter @reeeeecall/mobile start",
    "test:worker": "vitest run --config worker-modules/vitest.config.js",
    "test:integration": "bash scripts/local-supabase.sh with ./node_modules/.bin/vitest run --config tests/integration/vitest.config.ts tests/integration",
    "db:verify": "bash scripts/local-supabase.sh with bash .github/scripts/supabase-up.sh reset-only",
    "db:up": "bash scripts/local-supabase.sh up",
    "db:down": "bash scripts/local-supabase.sh down",
    "test:session-stress": "node scripts/session-stress-test.mjs"
  },
  "dependencies": {
    "expo": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.2"
  }
}
